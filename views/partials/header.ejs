<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ULOO</title>
  <meta name="theme-color" content="#011d15">
  <!-- Impede o browser (Chrome Android, Samsung Internet) de alterar as cores do site. -->
  <meta name="color-scheme" content="only dark">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-title" content="ULOO">
  <link rel="stylesheet" href="/style.css">
  <script src="/fx.js" defer></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/"><i class="brand-mark" aria-hidden="true"></i><span class="brand-name">ULO<b>O</b></span></a>
    <% if (!me && path !== '/entrar') { %><a class="btn ghost small" href="/entrar">Entrar</a><% } %>
  </div>
</header>
<% if (me) { %>
  <% const is = (...ps) => ps.some((p) => path === p || path.startsWith(p + '/'));
     const items = [
       ['/eventos', 'Eventos', 'home', is('/eventos', '/stories', '/bocas') && path !== '/stories/nova'],
       ['/pessoas', 'Pessoas', 'users', is('/pessoas')],
       ['/stories/nova', 'Novo momento', 'plus', false, 0, '', 'create'],
       ['/mensagens', 'Mensagens', 'message', is('/mensagens'), unreadCount, 'não lidas'],
       ['/u/' + me.id, 'Perfil', 'user', is('/u/' + me.id, '/perfil')],
     ];
     if (me.is_admin) items.push(['/admin', 'Admin', 'shield', is('/admin'), pendingCount, 'pendentes']); %>
  <nav class="dock <%= /^\/mensagens\/\d+/.test(path) ? 'in-chat' : '' %>" aria-label="Menu principal">
    <% for (const [href, label, icon, active, n, what, kind] of items) { %>
      <a href="<%= href %>" class="<%= kind || '' %> <%= active ? 'on' : '' %>" <%- active ? 'aria-current="page"' : '' %> data-label="<%= label %>" aria-label="<%= label %><%= n ? `, ${n} ${n === 1 ? what.replace(/s$/, '') : what}` : '' %>">
        <% if (active) { %><i class="nav-pill" aria-hidden="true"></i><% } %>
        <span class="dock-icon"><%- include('icon', { name: icon }) %><% if (n) { %><b class="badge" aria-hidden="true"><%= n > 99 ? '99+' : n %></b><% } %></span>
        <% if (active) { %><span class="dock-label" aria-hidden="true"><%= label %></span><% } %>
      </a>
    <% } %>
  </nav>
<% } %>
<main class="wrap">
<% if (error) { %><div class="alert" role="alert"><%- include('icon', { name: 'alert' }) %><span><%= error %></span></div><% } %>
