<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ULO Vida</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/">ULO<span>vida</span></a>
    <% if (me) { %>
      <nav>
        <a href="/eventos">Eventos</a>
        <a href="/pessoas">Pessoas</a>
        <a href="/u/<%= me.id %>">Perfil</a>
        <% if (me.is_admin) { %>
          <a href="/admin">Admin<% if (pendingCount) { %> <b class="badge"><%= pendingCount %></b><% } %></a>
        <% } %>
        <form method="post" action="/sair"><button class="linkbtn">Sair</button></form>
      </nav>
    <% } %>
  </div>
</header>
<main class="wrap">
<% if (error) { %><div class="alert"><%= error %></div><% } %>
