<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ULO Vida</title>
  <meta name="theme-color" content="#7a1f2b" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#3d1119" media="(prefers-color-scheme: dark)">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/"><i class="brand-mark" aria-hidden="true"></i>ULO <span>Vida</span></a>
    <% if (me) { %>
      <nav>
        <% const is = (...ps) => ps.some((p) => path === p || path.startsWith(p + '/'));
           const links = [
             ['/eventos', 'Eventos', is('/eventos', '/stories')],
             ['/pessoas', 'Pessoas', is('/pessoas')],
             ['/mensagens', 'Mensagens', is('/mensagens'), unreadCount, 'não lidas'],
             ['/u/' + me.id, 'Perfil', is('/u/' + me.id, '/perfil')],
           ];
           if (me.is_admin) links.push(['/admin', 'Admin', is('/admin'), pendingCount, 'pendentes']); %>
        <% for (const [href, label, active, n, what] of links) { %>
          <a href="<%= href %>" <%- active ? 'class="on" aria-current="page"' : '' %>><% if (active) { %><i class="nav-pill" aria-hidden="true"></i><% } %><%= label %><% if (n) { %> <b class="badge" aria-label="<%= n %> <%= what %>"><%= n > 99 ? '99+' : n %></b><% } %></a>
        <% } %>
        <form method="post" action="/sair"><button class="navbtn">Sair</button></form>
      </nav>
    <% } else if (path !== '/entrar') { %>
      <nav><a class="btn ghost small" href="/entrar">Entrar</a></nav>
    <% } %>
  </div>
</header>
<main class="wrap">
<% if (error) { %><div class="alert" role="alert"><%- include('icon', { name: 'alert' }) %><span><%= error %></span></div><% } %>
