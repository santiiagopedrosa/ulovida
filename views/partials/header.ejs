<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ULO Vida</title>
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/"><i class="brand-mark" aria-hidden="true"></i>ULO <span>Vida</span></a>
    <% if (me) { %>
      <nav>
        <% const on = (p) => path === p || path.startsWith(p + '/') ? 'class="on" aria-current="page"' : ''; %>
        <a href="/eventos" <%- on('/eventos') %>>Eventos</a>
        <a href="/pessoas" <%- on('/pessoas') %>>Pessoas</a>
        <a href="/u/<%= me.id %>" <%- on('/u/' + me.id) || on('/perfil') %>>Perfil</a>
        <% if (me.is_admin) { %>
          <a href="/admin" <%- on('/admin') %>>Admin<% if (pendingCount) { %> <b class="badge" aria-label="<%= pendingCount %> pendentes"><%= pendingCount %></b><% } %></a>
        <% } %>
        <form method="post" action="/sair"><button class="navbtn">Sair</button></form>
      </nav>
    <% } else if (path !== '/entrar') { %>
      <nav><a class="btn ghost small" href="/entrar">Entrar</a></nav>
    <% } %>
  </div>
</header>
<main class="wrap">
<% if (error) { %><div class="alert" role="alert"><%- include('icon', { name: 'alert' }) %><span><%= error %></span></div><% } %>
