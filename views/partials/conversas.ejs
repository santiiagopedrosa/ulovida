<div class="list convo-list">
  <% for (const c of conversations) { %>
    <a class="convo <%= c.unread ? 'unread' : '' %> <%= locals.activeId === c.other_id ? 'active' : '' %>" href="/mensagens/<%= c.other_id %>" <%- locals.activeId === c.other_id ? 'aria-current="page"' : '' %>>
      <%- include('avatar', { u: { id: c.other_id, name: c.name, photo_id: c.photo_id } }) %>
      <span class="convo-main">
        <span class="convo-top"><strong><%= c.name %></strong><span class="muted small"><%= timeAgo(c.created_at) %></span></span>
        <span class="convo-last"><%= c.sender_id === me.id ? 'Tu: ' : '' %><%= c.body %></span>
      </span>
      <% if (c.unread) { %><b class="badge dot" aria-label="<%= c.unread %> não lidas"><%= c.unread %></b><% } %>
    </a>
  <% } %>
  <% if (!conversations.length) { %><p class="empty">Ainda não tens conversas. Abre o perfil de alguém e carrega em <strong>Mensagem</strong>.</p><% } %>
</div>
