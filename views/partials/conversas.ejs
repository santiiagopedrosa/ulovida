<div class="list convo-list">
  <% for (const c of conversations) { const active = locals.activeKey === c.key; %>
    <a class="convo <%= c.unread ? 'unread' : '' %> <%= active ? 'active' : '' %>" href="<%= c.href %>" <%- active ? 'aria-current="page"' : '' %>>
      <% if (c.group_id) { %>
        <span class="avatar group-avatar" aria-hidden="true"><%- include('icon', { name: 'users' }) %></span>
      <% } else { %>
        <%- include('avatar', { u: { id: c.other_id, name: c.name, photo_id: c.photo_id } }) %>
      <% } %>
      <span class="convo-main">
        <span class="convo-top"><strong><%= c.name %></strong><span class="muted small"><%= timeAgo(c.created_at) %></span></span>
        <span class="convo-last"><% if (c.group_id && !c.body) { %>Grupo criado<% } else { %><%= c.sender_id === me.id ? 'Tu: ' : c.group_id ? `${c.sender_name.split(' ')[0]}: ` : '' %><%= c.body %><% } %></span>
      </span>
      <% if (c.unread) { %><b class="badge dot" aria-label="<%= c.unread %> não lidas"><%= c.unread %></b><% } %>
    </a>
  <% } %>
  <% if (!conversations.length) { %><p class="empty">Ainda não tens conversas. Abre o perfil de alguém e carrega em <strong>Mensagem</strong>, ou cria um grupo.</p><% } %>
</div>
