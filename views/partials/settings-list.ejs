<%# Lista das definições: usada na janela da roda dentada e na página /definicoes (sem JavaScript). %>
<% const rows = [
     ['/perfil/editar', 'pencil', 'Editar perfil', 'Foto, curso, praxe e bio', 0],
     ['/perfil/editar#biometria', 'fingerprint', 'Face ID / impressão digital', 'Entrar sem escrever a password', 0],
     ['/recuperar?email=' + encodeURIComponent(me.email), 'key', 'Mudar password', 'Enviamos um código para o teu email', 0],
   ];
   if (me.is_admin) rows.push(['/admin', 'shield', 'Admin', pendingCount ? `${pendingCount} ${pendingCount === 1 ? 'pedido pendente' : 'pedidos pendentes'}` : 'Aprovar eventos', pendingCount]); %>
<nav class="settings-list">
  <% for (const [href, icon, label, hint, n] of rows) { %>
    <a href="<%= href %>" class="settings-row">
      <span class="settings-icon"><%- include('icon', { name: icon }) %></span>
      <span class="settings-text"><strong><%= label %></strong><span class="muted small"><%= hint %></span></span>
      <% if (n) { %><b class="badge settings-badge"><%= n > 99 ? '99+' : n %></b><% } %>
      <%- include('icon', { name: 'chevron' }) %>
    </a>
  <% } %>
  <form method="post" action="/sair" class="settings-row-form">
    <button class="settings-row danger-row">
      <span class="settings-icon"><%- include('icon', { name: 'logout' }) %></span>
      <span class="settings-text"><strong>Sair</strong><span class="muted small"><%= me.email %></span></span>
    </button>
  </form>
</nav>
