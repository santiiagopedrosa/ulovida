<% const role = staffRole(u.id); %>
<%# Cada aluno tem a sua cor (fixa, a partir do número do cartão). 7 e 10 não têm divisores comuns, por isso números seguidos nunca repetem a cor. %>
<% const palette = ['#f7eb7d', '#c9dd9d', '#acd9d6', '#f1dadb', '#eb665b', '#c3b8f2', '#9fd2f2', '#f6b27a', '#7be3b1', '#e9a8d8'];
   const tone = role ? 'var(--yellow)' : palette[(Number(u.id) * 7) % palette.length]; %>
<div class="member-card <%= role ? 'founder' : '' %> <%= locals.reveal ? 'reveal-card' : '' %>" style="--tone: <%= tone %>" data-tilt>
  <i class="mc-corner" aria-hidden="true"></i><i class="mc-dot" aria-hidden="true"></i>
  <div class="mc-top"><span class="mc-brand">ULOO<i></i></span><span class="mc-kind">Cartão de estudante</span></div>
  <div class="mc-name"><span class="mc-name-text"><%= u.name %></span> <%- include('badges', { id: u.id }) %></div>
  <div class="mc-course"><%= [u.course, u.year].filter(Boolean).join(' · ') || 'Comunidade ULO' %></div>
  <div class="mc-bottom">
    <span><small>Nº</small><b><%= memberNo(u.id) %></b></span>
    <span><small>Escola</small><b><%= u.school || 'ULO' %></b></span>
    <span><small>Desde</small><b><%= memberSince(u.created_at) %></b></span>
  </div>
  <i class="mc-shine" aria-hidden="true"></i>
</div>
