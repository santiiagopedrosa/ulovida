<%- include('partials/header') %>
<section class="hero">
  
  <p class="eyebrow">Exclusivo para a comunidade ULO</p>
  <% let i = 0; const words = (t) => t.split(' ').map((w) => `<span style="--i:${i++}">${w}</span>`).join(' '); %>
  <h1 class="blur-text" aria-label="A vida académica, toda num sítio."><span aria-hidden="true"><%- words('A vida académica,') %> <em><%- words('toda num sítio.') %></em></span></h1>
  <p class="lead">Encontra colegas, descobre convívios e prés, partilha stories e fala com quem vai. Só entra quem tem email <strong>@ulo.pt</strong>.</p>
  <div class="row">
    <a class="btn" href="/registar">Criar conta</a>
    <a class="btn ghost" href="/entrar">Já tenho conta</a>
  </div>
  <p class="hero-foot">ESTG · ESECS · ESSLei · ESAD.CR · ESTM</p>
</section>
<section class="features">
  <div><strong>Eventos</strong><p class="muted small">Convívios e prés, públicos ou só para quem escolheres.</p></div>
  <div><strong>Stories</strong><p class="muted small">Fotos com texto e música que desaparecem em 24 horas.</p></div>
  <div><strong>Só ULO</strong><p class="muted small">Cada conta é confirmada com o email institucional.</p></div>
</section>
<%- include('partials/footer') %>
