<%- include('partials/header') %>
<div class="pagehead">
  <div>
    <h1>Pessoas</h1>
    <p class="muted"><%= people.length %> <%= people.length === 1 ? 'pessoa' : 'pessoas' %><%= q ? ` para “${q}”` : '' %></p>
  </div>
  <form method="get" class="search" role="search">
    <%- include('partials/icon', { name: 'search' }) %>
    <% if (escola) { %><input type="hidden" name="escola" value="<%= escola %>"><% } %>
    <input name="q" value="<%= q %>" placeholder="Procurar por nome ou curso" aria-label="Procurar pessoas">
  </form>
</div>
<nav class="tabs scroll" aria-label="Filtrar por escola">
  <% const qs = (e) => '/pessoas?' + new URLSearchParams({ ...(e && { escola: e }), ...(q && { q }) }); %>
  <% for (const e of ['', ...Object.keys(SCHOOLS)]) { %>
    <a href="<%= qs(e) %>" class="<%= escola === e ? 'on' : '' %>" <%- e ? `title="${SCHOOLS[e]}"` : '' %>><%= e || 'Todas' %><% if (escola === e) { %><i class="tab-line" aria-hidden="true"></i><% } %></a>
  <% } %>
</nav>
<div class="grid">
  <% for (const p of people) { %><%- include('partials/pessoa', { p, vt: true }) %><% } %>
</div>
<% if (!people.length) { %><p class="empty">Ninguém encontrado.</p><% } %>
<%- include('partials/footer') %>
