<%- include('partials/header') %>
<section class="panel">
  <h1>Confirma o teu email</h1>
  <p class="muted">Se <strong><%= email %></strong> ainda não tem conta, enviámos um código de 6 dígitos. Vê também o separador <strong>Outros</strong> e o <strong>Lixo eletrónico</strong> do Outlook.</p>
  <form method="post" action="/confirmar" class="form">
    <input type="hidden" name="email" value="<%= email %>">
    <label>Código
      <input class="code-input" name="code" value="<%= code %>" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" maxlength="6" placeholder="000000" required autofocus>
    </label>
    <button class="btn block">Confirmar</button>
  </form>
  <p class="muted small">Não recebeste? <a href="/registar?email=<%= encodeURIComponent(email) %>">Pedir um novo código</a>.</p>
</section>
<%- include('partials/footer') %>
