<%- include('partials/header') %>
<div class="pagehead">
  <div>
    <h1>Eventos</h1>
    <p class="muted">Convívios e prés da comunidade.</p>
  </div>
  <a class="btn" href="/eventos/novo"><%- include('partials/icon', { name: 'plus' }) %> Criar evento</a>
</div>
<% if (created) { %><div class="notice" role="status"><%- include('partials/icon', { name: 'check' }) %><span>Pedido enviado! O evento aparece aqui assim que for aprovado.</span></div><% } %>

<nav class="tabs" aria-label="Filtrar eventos">
  <a href="/eventos" class="<%= tipo === '' ? 'on' : '' %>">Todos</a>
  <a href="/eventos?tipo=convivio" class="<%= tipo === 'convivio' ? 'on' : '' %>">Convívios</a>
  <a href="/eventos?tipo=pre" class="<%= tipo === 'pre' ? 'on' : '' %>">Prés</a>
</nav>

<div class="list">
  <% for (const e of events) { %>
    <article class="event" id="e<%= e.id %>">
      <% const d = fmtParts(e.starts_at); %>
      <div class="date" aria-label="<%= fmtDate(e.starts_at) %>"><span class="wd"><%= d.weekday %></span><span class="d"><%= d.day %></span><span class="m"><%= d.month %></span></div>
      <div class="event-body">
        <span class="type <%= e.type %>"><%= TIPOS[e.type] %></span>
        <h3><%= e.title %></h3>
        <div class="meta">
          <span><%- include('partials/icon', { name: 'clock' }) %> <%= d.time %></span>
          <span><%- include('partials/icon', { name: 'pin' }) %> <%= e.location %></span>
          <span>por <a href="/u/<%= e.creator_id %>"><%= e.creator_name %></a><%- locals.showEmail ? ` <span class="muted">(${e.creator_email})</span>` : '' %></span>
        </div>
        <% if (e.description) { %><p class="bio"><%= e.description %></p><% } %>
        <% if (e.photo_id) { %><img class="event-photo" src="/img/<%= e.photo_id %>" alt="" loading="lazy" decoding="async"><% } %>
        <div class="event-foot">
          <div class="stack">
            <% for (const a of e.attendees) { %><a href="/u/<%= a.id %>" title="<%= a.name %>"><%- include('partials/avatar', { u: a }) %></a><% } %>
            <span class="muted"><%= e.going %> <%= e.going === 1 ? 'vai' : 'vão' %></span>
          </div>
          <form method="post" action="/eventos/<%= e.id %>/vou">
            <% if (e.im_going) { %>
              <button class="btn small ghost"><%- include('partials/icon', { name: 'check' }) %> Vais</button>
            <% } else { %>
              <button class="btn small">Vou</button>
            <% } %>
          </form>
        </div>
      </div>
    </article>
  <% } %>
  <% if (!events.length) { %><p class="empty">Ainda não há eventos marcados. <a href="/eventos/novo">Cria o primeiro</a>.</p><% } %>
</div>

<% if (mine.length) { %>
  <h2>Os teus pedidos</h2>
  <div class="list">
  <% for (const e of mine) { %>
    <div class="mini">
      <span class="status <%= e.status %>"><%= e.status === 'pending' ? 'Pendente' : 'Rejeitado' %></span>
      <span class="grow"><strong><%= e.title %></strong> <span class="muted small"><%= fmtDate(e.starts_at) %></span></span>
      <% if (e.status === 'pending') { %>
        <form method="post" action="/eventos/<%= e.id %>/cancelar" class="inline"><button class="linkbtn small">Cancelar</button></form>
      <% } else { %>
        <form method="post" action="/eventos/<%= e.id %>/fechar" class="inline"><button class="icon-btn" title="Fechar" aria-label="Fechar aviso de <%= e.title %>"><%- include('partials/icon', { name: 'x' }) %></button></form>
      <% } %>
    </div>
  <% } %>
  </div>
<% } %>
<%- include('partials/footer') %>
