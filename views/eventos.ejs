<%- include('partials/header') %>
<div class="pagehead">
  <div>
    <h1>Eventos</h1>
    <p class="muted">Convívios e prés da comunidade.</p>
  </div>
  <a class="btn" href="/eventos/novo"><%- include('partials/icon', { name: 'plus' }) %> Criar evento</a>
</div>
<div class="feed">
<div class="feed-main">
<section class="moments" aria-label="Momentos">
  <div class="moments-head"><h2>Momentos</h2><span class="muted small">Desaparecem em 24 h · só para quem te segue</span></div>
  <div class="moments-bar">
    <a class="moment add" href="/stories/nova">
      <span class="moment-plus"><%- include('partials/icon', { name: 'plus' }) %></span>
      <span class="moment-name">Novo momento</span>
    </a>
    <% for (const st of stories) { %>
      <a class="moment <%= st.unseen ? 'new' : 'seen' %>" href="/stories/<%= st.id %>">
        <% if (st.cover) { %><img src="/img/<%= st.cover %>" alt="" loading="lazy" decoding="async"><% } %>
        <% if (st.unseen) { %><span class="moment-new">Novo</span><% } %>
        <span class="moment-who"><%- include('partials/avatar', { u: st }) %><span class="moment-name"><%= st.id === me.id ? 'Tu' : st.name.split(' ')[0] %></span></span>
      </a>
    <% } %>
    <% if (!stories.length) { %><p class="moments-empty muted small">Segue colegas para veres os momentos deles aqui.</p><% } %>
  </div>
</section>

<% if (created) { %><div class="notice" role="status"><%- include('partials/icon', { name: 'check' }) %><span>Pedido enviado! O evento aparece aqui assim que for aprovado.</span></div><% } %>

<%- include('partials/feed-tabs', { active: tipo }) %>

<div class="list">
  <% for (const e of events) { %>
    <article class="event <%= e.type %>" id="e<%= e.id %>">
      <% const d = fmtParts(e.starts_at); %>
      <% if (e.im_going) { %><span class="stamp" aria-hidden="true">Vou</span><% } %>
      <div class="date" aria-label="<%= fmtDate(e.starts_at) %>"><span class="wd"><%= d.weekday %></span><span class="d"><%= d.day %></span><span class="m"><%= d.month %></span></div>
      <div class="event-body">
        <span class="type <%= e.type %>"><%= TIPOS[e.type] %></span><% if (e.visibility !== 'public') { %><span class="private"><%- include('partials/icon', { name: 'lock' }) %> <%= e.visibility === 'mutual' ? 'Seguidores mútuos' : 'Só convidados' %></span><% } %>
        <h3><a href="/eventos/<%= e.id %>" class="event-title"><%= e.title %></a></h3>
        <div class="meta">
          <span><%- include('partials/icon', { name: 'clock' }) %> <%= d.time %></span>
          <span><%- include('partials/icon', { name: 'pin' }) %> <%= e.location %></span>
          <span>por <a href="/u/<%= e.creator_id %>"><%= e.creator_name %></a><%- locals.showEmail ? ` <span class="muted">(${e.creator_email})</span>` : '' %></span>
        </div>
        <% if (e.description) { %><p class="bio"><%= e.description %></p><% } %>
        <% if (e.photo_id) { %><img class="event-photo" src="/img/<%= e.photo_id %>" alt="" loading="lazy" decoding="async"><% } %>
        <div class="event-foot">
          <div class="stack">
            <% for (const a of e.attendees) { %><a href="/u/<%= a.id %>" title="<%= a.name %>"><%- include('partials/avatar', { u: a }) %></a><% } %>
            <span class="muted"><%= e.going %> <%= e.going === 1 ? 'vai' : 'vão' %></span>
            <a class="boca-link" href="/eventos/<%= e.id %>#comentarios" aria-label="<%= e.comments %> <%= e.comments === 1 ? 'comentário' : 'comentários' %>"><%- include('partials/icon', { name: 'message' }) %> <span><%= e.comments %></span></a>
          </div>
          <form method="post" action="/eventos/<%= e.id %>/vou">
            <% if (e.im_going) { %>
              <button class="btn small ghost"><%- include('partials/icon', { name: 'ticket' }) %> Tenho lugar</button>
            <% } else { %>
              <button class="btn small"><%- include('partials/icon', { name: 'ticket' }) %> Vou</button>
            <% } %>
          </form>
        </div>
      </div>
    </article>
  <% } %>
  <% if (!events.length) { %><p class="empty">Ainda não há eventos marcados. <a href="/eventos/novo">Cria o primeiro</a>.</p><% } %>
</div>
</div>
<aside class="feed-side">
  <section class="side-card">
    <h2>Sugestões para ti</h2>
    <% for (const p of suggestions) { %>
      <div class="suggest">
        <a href="/u/<%= p.id %>" class="suggest-user"><%- include('partials/avatar', { u: p }) %><span><strong><%= p.name %></strong><span class="muted small"><%= [p.school, p.course].filter(Boolean).join(' · ') || 'ULO' %></span></span></a>
        <form method="post" action="/u/<%= p.id %>/seguir"><input type="hidden" name="voltar" value="/eventos"><button class="btn small">Seguir</button></form>
      </div>
    <% } %>
    <% if (!suggestions.length) { %><p class="muted small">Já segues toda a gente.</p><% } %>
    <a class="side-link" href="/pessoas">Ver todas as pessoas →</a>
  </section>
  <% if (mine.length) { %>
    <h2>Os teus pedidos</h2>
    <div class="list">
    <% for (const e of mine) { %>
      <div class="mini">
        <span class="status <%= e.status %>"><%= e.status === 'pending' ? 'Pendente' : 'Rejeitado' %></span>
        <span class="grow"><strong><%= e.title %></strong> <span class="muted small"><%= fmtDate(e.starts_at) %></span></span>
        <% if (e.status === 'pending') { %>
          <form method="post" action="/eventos/<%= e.id %>/cancelar" class="inline"><button class="linkbtn small">Cancelar</button></form>
        <% } else { %>
          <form method="post" action="/eventos/<%= e.id %>/fechar" class="inline"><button class="icon-btn" title="Fechar" aria-label="Fechar aviso de <%= e.title %>"><%- include('partials/icon', { name: 'x' }) %></button></form>
        <% } %>
      </div>
    <% } %>
    </div>
  <% } %>
</aside>
</div>
<%- include('partials/footer') %>
