<%- include('partials/header') %>
<section class="panel">
  <h1>Criar conta</h1>
  <p class="muted">Usa o teu email institucional. Vamos enviar-te um código para confirmares que és da ULO.</p>
  <form method="post" action="/registar" class="form" data-once>
    <label>Email institucional
      <input type="email" name="email" value="<%= email %>" placeholder="nome@ulo.pt" pattern=".+@ulo\.pt" autocomplete="email" required autofocus>
    </label>
    <button class="btn block" data-busy="A enviar…">Enviar código</button>
  </form>
  <p class="muted small">Já recebeste o código? <a href="/confirmar" id="have-code">Escrever o código</a>.</p>
  <p class="muted small">Já tens conta? <a href="/entrar">Entra aqui</a>.</p>
</section>
<%- include('partials/footer') %>
