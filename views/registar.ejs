<%- include('partials/header') %>
<section class="card narrow">
  <h1>Criar conta</h1>
  <p class="muted">Usa o teu email institucional. Vamos enviar-te um link para confirmares que és da ULO.</p>
  <form method="post" action="/registar" class="form">
    <label>Email institucional
      <input type="email" name="email" value="<%= email %>" placeholder="nome@ulo.pt" pattern=".+@ulo\.pt" required autofocus>
    </label>
    <button class="btn">Enviar link de confirmação</button>
  </form>
  <p class="muted small">Já tens conta? <a href="/entrar">Entra aqui</a>.</p>
</section>
<%- include('partials/footer') %>
