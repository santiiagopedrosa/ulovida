<%- include('partials/header') %>
<div class="dm in-chat">
<aside class="dm-list"><%- include('partials/conversas', { conversations }) %></aside>
<section class="chat" data-base="/mensagens/<%= other.id %>" data-other="<%= other.id %>" data-other-name="<%= other.name.split(' ')[0] %>" data-last="<%= messages.length ? messages.at(-1).id : 0 %>">
  <header class="chat-head">
    <a href="/mensagens" class="icon-btn" aria-label="Voltar às mensagens">←</a>
    <a href="/u/<%= other.id %>" class="chat-user"><%- include('partials/avatar', { u: other }) %><span><strong><%= other.name %> <%- include('partials/badges', { id: other.id }) %></strong><span class="muted small"><%= other.course %></span></span></a>
  </header>
  <div class="chat-log" aria-live="polite">
    <% for (const m of messages) { %>
      <div class="bubble <%= m.sender_id === me.id ? 'mine' : '' %>" data-id="<%= m.id %>"><% if (m.story_id) { %><span class="bubble-story"><%= m.sender_id === me.id ? `Respondeste ao momento de ${other.name.split(' ')[0]}` : 'Respondeu ao teu momento' %><% if (m.story_image) { %><img src="/img/<%= m.story_image %>" alt="Momento"><% } else { %> · expirou<% } %></span><% } %><span><%= m.body %></span><time><%= fmtTime(m.created_at) %></time></div>
    <% } %>
    <% if (!messages.length) { %><p class="muted small chat-empty">Diz olá a <%= other.name.split(' ')[0] %>.</p><% } %>
    <span id="fim"></span>
  </div>
  <form class="chat-form" method="post" action="/mensagens/<%= other.id %>">
    <textarea name="body" rows="1" maxlength="2000" placeholder="Escreve uma mensagem…" aria-label="Mensagem" required></textarea>
    <button class="btn" aria-label="Enviar"><%- include('partials/icon', { name: 'send' }) %></button>
  </form>
</section>
</div>
<script src="/chat.js" defer></script>
<%- include('partials/footer') %>
