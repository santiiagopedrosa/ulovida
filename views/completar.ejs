<%- include('partials/header') %>
<section class="panel">
  <h1>Email confirmado</h1>
  <p class="muted">Falta pouco. Completa os teus dados para <strong><%= email %></strong>.</p>
  <form method="post" action="/verificar" class="form">
    <input type="hidden" name="token" value="<%= token %>">
    <label>Nome
      <input name="name" value="<%= form.name || '' %>" maxlength="60" autocomplete="name" required>
    </label>
    <%- include('partials/curso-campos', { form }) %>
    <label>Ano
      <select name="year" required>
        <option value="">Escolher…</option>
        <% for (const a of ANOS) { %><option <%= form.year === a ? 'selected' : '' %>><%= a %></option><% } %>
      </select>
    </label>
    <label>Password <span class="hint">Pelo menos 8 caracteres</span>
      <input type="password" name="password" minlength="8" autocomplete="new-password" required>
    </label>
    <button class="btn block">Criar conta</button>
  </form>
</section>
<%- include('partials/footer') %>
