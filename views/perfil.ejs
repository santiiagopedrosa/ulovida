<%- include('partials/header') %>
<section class="profile">
  <% if (hasStory) { %>
    <a class="story-ring big" href="/stories/<%= user.id %>" title="Ver stories"><%- include('partials/avatar', { u: user, big: true, vt: true }) %></a>
  <% } else if (me.id === user.id) { %>
    <a class="avatar-link" href="/perfil/editar" title="Mudar foto de perfil"><%- include('partials/avatar', { u: user, big: true, vt: true }) %></a>
  <% } else { %>
    <%- include('partials/avatar', { u: user, big: true, vt: true }) %>
  <% } %>
  <div class="profile-main">
    <h1><%= user.name %> <%- include('partials/badges', { id: user.id }) %></h1>
    <p class="muted"><%= [user.school, user.course, user.year].filter(Boolean).join(' · ') %></p>
    <div class="counts">
      <a href="/u/<%= user.id %>/seguidores"><strong><%= followers %></strong> <%= followers === 1 ? 'seguidor' : 'seguidores' %></a>
      <a href="/u/<%= user.id %>/a-seguir"><strong><%= following %></strong> a seguir</a>
      <% if (followsMe && me.id !== user.id) { %><span class="tag">Segue-te</span><% } %>
    </div>
    <div class="facts">
      <% const founder = { 1: 'Fundador', 2: 'Co-fundador' }[user.id]; if (founder) { %><div><span class="label">ULOO</span><%= founder %></div><% } %>
      <div><span class="label">Praxe</span><%= PRAXE[user.praxe] || '—' %></div>
      <% if (user.praxe_name && user.praxe !== 'nao') { %><div><span class="label">Nome de praxe</span><%= user.praxe_name %></div><% } %>
      <div><span class="label">Relação</span><%= RELACAO[user.relationship] || '—' %></div>
      <% if (user.instagram) { %>
        <div><span class="label">Instagram</span><a href="https://instagram.com/<%= user.instagram %>" target="_blank" rel="noopener">@<%= user.instagram %></a></div>
      <% } %>
    </div>
    <% if (user.bio) { %><p class="bio"><%= user.bio %></p><% } %>
    <div class="row">
        <form method="post" action="/u/<%= user.id %>/seguir">
          <% if (iFollow) { %>
            <button class="btn ghost small"><%- include('partials/icon', { name: 'check' }) %> A seguir</button>
          <% } else { %>
            <button class="btn small"><%= followsMe ? 'Seguir de volta' : 'Seguir' %></button>
          <% } %>
        </form>
        <a class="btn ghost small" href="/mensagens/<%= user.id %>"><%- include('partials/icon', { name: 'message' }) %> Mensagem</a>
      <% } %>
    </div>
  </div>
</section>

<div class="profile-card"><%- include('partials/member-card', { u: user }) %></div>

<div class="two">
  <section>
    <h2>Vai a</h2>
    <% for (const e of going) { %>
      <div class="mini"><span class="type <%= e.type %>" style="margin:0"><%= TIPOS[e.type] %></span> <span class="grow"><strong><%= e.title %></strong> <span class="muted small"><%= fmtDate(e.starts_at) %></span></span></div>
    <% } %>
    <% if (!going.length) { %><p class="muted small">Nada marcado.</p><% } %>
  </section>
  <section>
    <h2>Organizou</h2>
    <% for (const e of created) { %>
      <div class="mini"><span class="type <%= e.type %>" style="margin:0"><%= TIPOS[e.type] %></span> <span class="grow"><strong><%= e.title %></strong> <span class="muted small"><%= fmtDate(e.starts_at) %></span></span></div>
    <% } %>
    <% if (!created.length) { %><p class="muted small">Ainda nada.</p><% } %>
  </section>
</div>
<%- include('partials/footer') %>
