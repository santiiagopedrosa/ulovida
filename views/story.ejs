<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ULOO</title>
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="only dark">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-title" content="ULOO">
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="story-page">
<div class="story-viewer" data-start="<%= start %>" data-mine="<%= mine ? 1 : 0 %>">
  <div class="story-bars"><% for (const st of stories) { %><span><i></i></span><% } %></div>
  <header class="story-head">
    <a href="/u/<%= user.id %>" class="story-user"><%- include('partials/avatar', { u: user }) %><strong><%= user.name %></strong></a>
    <span class="story-time"></span>
    <a href="/eventos" class="story-close" aria-label="Fechar"><%- include('partials/icon', { name: 'x' }) %></a>
  </header>
  <% stories.forEach((st, i) => { %>
    <figure class="story-slide" data-id="<%= st.id %>" data-time="<%= timeAgo(st.created_at) %>" data-views="<%= st.views %>" data-likes="<%= st.likes %>" data-liked="<%= st.liked ? 1 : 0 %>"
      <% if (st.music_preview) { %>data-music="<%= st.music_preview %>" data-music-title="<%= st.music_title %>" data-music-artist="<%= st.music_artist %>" data-music-artwork="<%= st.music_artwork || '' %>" data-music-url="<%= st.music_url || '' %>" data-music-start="<%= st.music_start || 0 %>"<% } %> hidden>
      <img src="/img/<%= st.image_id %>" alt="Story de <%= user.name %>" <%= i === start ? '' : 'loading="lazy"' %>>
    </figure>
  <% }) %>
  <a class="story-music" target="_blank" rel="noopener" hidden title="Ouvir na Apple Music"><img alt=""><span><strong></strong><small></small></span></a>
  <button type="button" class="story-sound" hidden aria-label="Ligar som"><%- include('partials/icon', { name: 'mute' }) %></button>
  <template id="icon-volume"><%- include('partials/icon', { name: 'volume' }) %></template>
  <template id="icon-mute"><%- include('partials/icon', { name: 'mute' }) %></template>
  <button class="story-nav prev" aria-label="Anterior"></button>
  <button class="story-nav next" aria-label="Seguinte"></button>
  <% if (mine) { %>
    <footer class="story-foot">
      <button type="button" class="story-views" aria-haspopup="dialog"><%- include('partials/icon', { name: 'eye' }) %> <b></b><span class="story-likes"><%- include('partials/icon', { name: 'heart' }) %> <i></i></span></button>
      <form method="post" class="story-delete"><button class="btn small danger"><%- include('partials/icon', { name: 'trash' }) %> Apagar</button></form>
    </footer>
    <dialog class="viewers-sheet" aria-label="Quem viu">
      <div class="viewers-head"><strong>Visto por</strong><button type="button" class="viewers-close" aria-label="Fechar"><%- include('partials/icon', { name: 'x' }) %></button></div>
      <ul class="viewers-list"></ul>
    </dialog>
  <% } else { %>
    <footer class="story-foot reply">
      <form class="story-reply" autocomplete="off">
        <input name="body" maxlength="1000" placeholder="Responder a <%= user.name.split(' ')[0] %>…" aria-label="Responder à story" enterkeyhint="send">
        <button type="submit" class="story-send" aria-label="Enviar" hidden><%- include('partials/icon', { name: 'send' }) %></button>
      </form>
      <button type="button" class="story-like" aria-pressed="false" aria-label="Gosto"><%- include('partials/icon', { name: 'heart' }) %></button>
    </footer>
    <p class="story-toast" role="status" hidden></p>
  <% } %>
</div>
<script src="/story.js" defer></script>
</body>
</html>
