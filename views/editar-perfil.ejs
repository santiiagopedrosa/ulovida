<%- include('partials/header') %>
<section class="panel">
  <h1><%= novo ? 'Bem-vindo/a!' : 'Editar perfil' %></h1>
  <% if (novo) { %>
    <p class="welcome-no">És o membro nº <b><%= memberNo(form.id) %></b> do ULOO.</p>
    <%- include('partials/member-card', { u: form, reveal: true }) %>
  <% } %>
  <p class="muted"><%= novo ? 'Conta criada. Completa o teu perfil: tudo' : 'Tudo' %> o que está aqui é visível para outras pessoas da ULO.</p>
  <form method="post" action="/perfil/editar" class="form" enctype="multipart/form-data">
    <div class="photo-field">
      <%# Tocar no círculo abre a galeria/câmara para escolher a foto de perfil. %>
      <label class="avatar-pick" aria-label="<%= form.photo_id ? 'Mudar foto de perfil' : 'Escolher foto de perfil' %>">
        <img id="avatar-preview" class="avatar big" <%- form.photo_id ? `src="/img/${form.photo_id}"` : 'hidden' %> alt="">
        <span class="avatar-ph"><%- include('partials/avatar', { u: { ...form, photo_id: null }, big: true }) %></span>
        <span class="avatar-pick-badge" aria-hidden="true"><%- include('partials/icon', { name: 'camera' }) %></span>
        <input type="file" name="photo" accept="image/*" data-max="800" data-aspect="1" data-round data-preview="avatar-preview">
      </label>
      <div>
        <p class="avatar-pick-tip"><%= form.photo_id ? 'Toca na foto para a mudar.' : 'Toca no círculo para escolher uma foto.' %></p>
        <% if (form.photo_id) { %>
          <label class="check"><input type="checkbox" name="remove_photo" value="1"> Remover foto</label>
        <% } %>
        <p class="hint">JPG, PNG ou WebP.</p>
      </div>
    </div>
    <label>Nome <input name="name" value="<%= form.name %>" maxlength="60" autocomplete="name" required></label>
    <%- include('partials/curso-campos', { form }) %>
    <label>Ano
      <select name="year" required>
        <% for (const a of ANOS) { %><option <%= form.year === a ? 'selected' : '' %>><%= a %></option><% } %>
      </select>
    </label>
    <label>Praxe
      <select name="praxe" id="praxe-select">
        <option value="">Prefiro não dizer</option>
        <% for (const [k, v] of Object.entries(PRAXE)) { %><option value="<%= k %>" <%= form.praxe === k ? 'selected' : '' %>><%= v %></option><% } %>
      </select>
    </label>
    <label id="praxe-name-field" <%= form.praxe && form.praxe !== 'nao' ? '' : 'hidden' %>>Nome de praxe <span class="hint">Opcional — como te chamam na praxe</span>
      <input name="praxe_name" value="<%= form.praxe_name || '' %>" maxlength="40" placeholder="ex: Caloiro Pastel de Nata">
    </label>
    <script>
      // Mostra o campo do nome de praxe só a quem faz praxe.
      document.getElementById('praxe-select').addEventListener('change', (e) => {
        document.getElementById('praxe-name-field').hidden = !e.target.value || e.target.value === 'nao';
      });
    </script>
    <label>Estado de relação
      <select name="relationship">
        <option value="">Prefiro não dizer</option>
        <% for (const [k, v] of Object.entries(RELACAO)) { %><option value="<%= k %>" <%= form.relationship === k ? 'selected' : '' %>><%= v %></option><% } %>
      </select>
    </label>
    <label>Instagram <input name="instagram" value="<%= form.instagram %>" placeholder="@utilizador" maxlength="31"></label>
    <label>Bio <span class="hint">Até 500 caracteres</span><textarea name="bio" rows="4" maxlength="500"><%= form.bio %></textarea></label>
    <button class="btn block">Guardar</button>
  </form>

  <section class="bio-settings" id="biometria">
    <h2>Entrar com <span data-bio-label>Face ID</span></h2>
    <p class="muted small">Entra no ULOO sem escrever a password. A tua cara ou impressão digital nunca sai do telemóvel — o ULOO só recebe uma chave de confirmação.</p>
    <% for (const k of passkeys) { %>
      <div class="bio-device">
        <%- include('partials/icon', { name: 'fingerprint' }) %>
        <span class="grow"><strong><%= k.device %></strong><span class="muted small">Ativado a <%= fmtDate(new Date(k.created_at).toISOString()) %><%= k.last_used_at ? ` · usado ${timeAgo(k.last_used_at)}` : '' %></span></span>
        <form method="post" action="/biometria/apagar" onsubmit="return confirm('Desativar neste aparelho?')">
          <input type="hidden" name="id" value="<%= k.id %>">
          <button class="btn ghost small danger">Desativar</button>
        </form>
      </div>
    <% } %>
    <div data-bio hidden>
      <button type="button" class="btn small" data-bio-register><%- include('partials/icon', { name: 'fingerprint' }) %> Ativar neste aparelho</button>
      <p class="hint bio-error" data-bio-error hidden></p>
    </div>
    <p class="hint" data-bio-unsupported hidden>Este aparelho ou browser não tem Face ID nem impressão digital disponível.</p>
  </section>
</section>
<script src="/upload.js" defer></script>
<script src="/vendor/simplewebauthn-browser.min.js" defer></script>
<script src="/biometria.js" defer></script>
<%- include('partials/footer') %>
