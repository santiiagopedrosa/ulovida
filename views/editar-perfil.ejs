<%- include('partials/header') %>
<section class="panel">
  <h1><%= novo ? 'Bem-vindo/a!' : 'Editar perfil' %></h1>
  <p class="muted"><%= novo ? 'Conta criada. Completa o teu perfil — ' : '' %>Tudo o que está aqui é visível para outras pessoas da ULO.</p>
  <form method="post" action="/perfil/editar" class="form" enctype="multipart/form-data">
    <div class="photo-field">
      <% if (form.photo_id) { %>
        <img id="avatar-preview" class="avatar big" src="/img/<%= form.photo_id %>" alt="">
      <% } else { %>
        <img id="avatar-preview" class="avatar big" alt="" hidden>
      <% } %>
      <div>
        <label class="btn ghost small file-btn">
          <%- include('partials/icon', { name: 'camera' }) %> <%= form.photo_id ? 'Mudar foto' : 'Adicionar foto' %>
          <input type="file" name="photo" accept="image/*" data-max="800" data-aspect="1" data-round data-preview="avatar-preview">
        </label>
        <% if (form.photo_id) { %>
          <label class="check"><input type="checkbox" name="remove_photo" value="1"> Remover foto</label>
        <% } %>
        <p class="hint">JPG, PNG ou WebP.</p>
      </div>
    </div>
    <label>Nome <input name="name" value="<%= form.name %>" maxlength="60" autocomplete="name" required></label>
    <label>Curso <input name="course" value="<%= form.course %>" maxlength="80"></label>
    <label>Ano
      <select name="year" required>
        <% for (const a of ANOS) { %><option <%= form.year === a ? 'selected' : '' %>><%= a %></option><% } %>
      </select>
    </label>
    <label>Praxe
      <select name="praxe">
        <option value="">Prefiro não dizer</option>
        <% for (const [k, v] of Object.entries(PRAXE)) { %><option value="<%= k %>" <%= form.praxe === k ? 'selected' : '' %>><%= v %></option><% } %>
      </select>
    </label>
    <label>Estado de relação
      <select name="relationship">
        <option value="">Prefiro não dizer</option>
        <% for (const [k, v] of Object.entries(RELACAO)) { %><option value="<%= k %>" <%= form.relationship === k ? 'selected' : '' %>><%= v %></option><% } %>
      </select>
    </label>
    <label>Instagram <input name="instagram" value="<%= form.instagram %>" placeholder="@utilizador" maxlength="31"></label>
    <label>Bio <span class="hint">Até 500 caracteres</span><textarea name="bio" rows="4" maxlength="500"><%= form.bio %></textarea></label>
    <button class="btn block">Guardar</button>
  </form>
</section>
<script src="/upload.js" defer></script>
<%- include('partials/footer') %>
